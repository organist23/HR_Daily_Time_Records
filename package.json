{
  "name": "employees-dtr-analyzer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "start": "vite build && electron .",
    "test:e2e": "vite build && playwright test",
    "dist": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "ph.gov.lgu.dtr-analyzer",
    "productName": "Employees DTR Analyzer",
    "files": ["dist/**", "electron/**", "src/lib/**", "package.json"],
    "directories": { "output": "release", "buildResources": "build" },
    "win": { "icon": "build/icon.ico", "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Employees DTR Analyzer"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
